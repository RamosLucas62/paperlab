# DEMO is the only mode used automatically. Never set a live trading mode.
APP_MODE=demo
DATABASE_URL=sqlite:///./paperlab.db
SESSION_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
COOKIE_SECURE=false

# VPS/EasyPanel only: 32-byte hex string, e.g. openssl rand -hex 32.
# The local docker-compose.yml uses its own local-only database password.
POSTGRES_PASSWORD=

# Optional external PAPER integrations. Leave empty for offline DEMO.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
ALPACA_PAPER_A_KEY_ID=
ALPACA_PAPER_A_SECRET_KEY=
ALPACA_PAPER_B_KEY_ID=
ALPACA_PAPER_B_SECRET_KEY=
ALPACA_PAPER_C_KEY_ID=
ALPACA_PAPER_C_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=
JEV_MODEL=typesafe/jev-1.13

# Monad mainnet and Kuru MON/USDC read-only market feed.
# Fill KURU_MARKET_ADDRESS with the MON/USDC market address from Kuru.
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143
KURU_WS_URL=wss://ws.kuru.io/
KURU_MARKET_ADDRESS=
KURU_SYMBOL=MON/USDC
TERMINAL_SAMPLE_INTERVAL_SECONDS=5
TERMINAL_JEV_INTERVAL_SECONDS=120

# Versioned experimental controls; these never promise a maximum loss.
AI_DAILY_BUDGET_USD=2.00
AI_CALL_BUDGET_USD=0.10
MAX_OPEN_POSITIONS=1
MAX_ORDER_NOTIONAL_USD=100
MAX_DAILY_ORDERS=6
MAX_SIMULATED_DRAWDOWN_USD=500
